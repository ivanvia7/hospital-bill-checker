{
  "name": "hospital-bill-checker",
  "version": "1.0.0",
  "description": "Check your hospital bill line by line against the hospital's own posted prices",
  "bin": {
    "hospital-bill-checker": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "esbuild web/main.ts --bundle --format=esm --platform=browser --outfile=web/main.js --alias:node:stream=readable-stream --alias:stream=readable-stream --alias:node:buffer=buffer --alias:node:string_decoder=string_decoder --define:global=globalThis --inject:web/node-globals.js",
    "prepack": "npm run build",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "readable-stream": "^4.8.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "camoufox": "^0.5.8",
    "csv-parse": "^7.0.3",
    "stream-chain": "^4.4.1",
    "stream-json": "^3.8.0",
    "unpdf": "^1.9.1"
  }
}
